---
import '../styles/global.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/700.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'WHY —— 项目、竞赛、思考，以及正在做的事。',
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} · WHY` : 'WHY · 无限进步';
const site = Astro.site ?? new URL('https://qwhyq.com');
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#f4b1c5" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="WHY" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={`${site.origin}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="WHY · 无限进步" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site.origin}/og.png`} />
    <link rel="alternate" type="application/rss+xml" title="WHY" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到主要内容</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (function () {
        var els = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
        if (!els.length) return;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (el) {
            el.classList.add('is-in');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: -60px;
    left: 24px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 10px;
    background: var(--c-ink);
    color: var(--c-canvas);
    font-size: 14px;
    transition: top 160ms var(--ease-apple);
  }

  .skip:focus-visible {
    top: 12px;
    outline-color: var(--c-pink);
  }
</style>
