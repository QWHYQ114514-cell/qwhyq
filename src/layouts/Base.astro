---
import '../styles/global.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/700.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'WHY —— 项目、竞赛、思考，以及正在做的事。',
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} · WHY` : 'WHY · 无限进步';
const site = Astro.site ?? new URL('https://qwhyq.pages.dev');
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#f4b1c5" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="WHY" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={`${site.origin}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="WHY · 无限进步" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site.origin}/og.png`} />
    <link rel="alternate" type="application/rss+xml" title="WHY" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到主要内容</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (function () {
        /* ---------- 导航栏：滚动后变毛玻璃 ---------- */
        var nav = document.querySelector('.nav-wrap');
        if (nav) {
          var syncNav = function () {
            nav.classList.toggle('is-scrolled', (window.scrollY || 0) > 8);
          };
          window.addEventListener('scroll', syncNav, { passive: true });
          syncNav();
        }

        /* ---------- 整页字体门禁 + 逐块浮现 ---------- */
        var els = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));

        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          document.documentElement.classList.add('fonts-ready');
          els.forEach(function (el) {
            el.classList.add('is-in');
          });
          return;
        }

        var reveal = function (el) {
          el.classList.add('is-in');
        };

        /*
         * 按"整页文字"加载字体，而不是只按几个 data-reveal 元素。
         * 明朝体切成上百片，页面里除了标题还有卡片标题、列表行、Now 区…
         * 它们不带 data-reveal，照样会先画回退字体再变 —— 所以门禁必须开在整页。
         */
        var pageText = ((document.querySelector('main') || document.body).textContent || '')
          .replace(/\s+/g, ' ')
          .slice(0, 4000);

        var loaders = [];
        if (document.fonts && document.fonts.load && pageText) {
          loaders.push(
            document.fonts.load('600 16px "Noto Serif SC"', pageText).catch(function () {})
          );
          loaders.push(
            document.fonts.load('700 16px "Noto Serif SC"', pageText).catch(function () {})
          );
        }

        var start = function () {
          // 打开整页门禁：main 从 opacity 0 淡入
          document.documentElement.classList.add('fonts-ready');

          /*
           * 视口内的元素直接显示，不依赖 IntersectionObserver ——
           * IO 在某些环境（省电模式、无头浏览器、后台标签页）会被节流，
           * 一旦它不回调，首屏就会一直是空白。先手算一遍位置最稳。
           */
          var rest = [];
          els.forEach(function (el) {
            var r = el.getBoundingClientRect();
            var inView = r.top < window.innerHeight * 1.02 && r.bottom > 0;
            if (inView) reveal(el);
            else rest.push(el);
          });

          if (!rest.length) return;
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  reveal(entry.target);
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          rest.forEach(function (el) {
            io.observe(el);
          });
        };

        /*
         * 等字体加载完 + 40ms 再开始：这 40ms 保证 opacity:0 的初始态
         * 至少被真正绘制过一帧，否则浏览器会把"隐藏"和"显示"合成一帧，
         * 过渡根本不跑（表现就是文字直接蹦出来，没有浮现）。
         */
        Promise.race([
          Promise.all(loaders),
          new Promise(function (r) {
            setTimeout(r, 1500);
          }),
        ]).then(function () {
          setTimeout(start, 40);
        });

        /* 保底：4 秒后无论如何都要把内容放出来。
           防的是字体请求卡住或 IntersectionObserver 被节流，导致整页空白。 */
        setTimeout(function () {
          document.documentElement.classList.add('fonts-ready');
          els.forEach(function (el) {
            if (el.classList.contains('is-in')) return;
            var r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) reveal(el);
          });
        }, 4000);
      })();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: -60px;
    left: 24px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 10px;
    background: var(--c-ink);
    color: var(--c-canvas);
    font-size: 14px;
    transition: top 160ms var(--ease-apple);
  }

  .skip:focus-visible {
    top: 12px;
    outline-color: var(--c-pink);
  }
</style>
