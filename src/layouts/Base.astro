---
import '../styles/global.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/700.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'WHY —— 项目、竞赛、思考，以及正在做的事。',
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} · WHY` : 'WHY · 无限进步';
const site = Astro.site ?? new URL('https://qwhyq.pages.dev');
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#f4b1c5" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="WHY" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={`${site.origin}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="WHY · 无限进步" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site.origin}/og.png`} />
    <link rel="alternate" type="application/rss+xml" title="WHY" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到主要内容</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (function () {
        /* ---------- 导航栏：滚动后变毛玻璃 ---------- */
        var nav = document.querySelector('.nav-wrap');
        if (nav) {
          var syncNav = function () {
            nav.classList.toggle('is-scrolled', (window.scrollY || 0) > 8);
          };
          window.addEventListener('scroll', syncNav, { passive: true });
          syncNav();
        }

        /* ---------- 文字浮现 ---------- */
        var els = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
        if (!els.length) return;

        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (el) {
            el.classList.add('is-in');
          });
          return;
        }

        /*
         * 等字体就绪再开始：明朝体是按 unicode-range 切片异步加载的，
         * 先显示回退字体会让文字"抽"一下（swap），浮现动画也就看不出来了。
         * 等字体这几百毫秒里，元素本来就是 opacity:0 且已经绘制过，
         * 所以之后再加 is-in，过渡一定跑得起来（不需要再等帧）。
         * 但最多等 700ms，不能因为字体慢就让内容一直藏着。
         */
        var reveal = function (el) {
          el.classList.add('is-in');
        };

        var fontsReady =
          document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();

        var start = function () {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  reveal(entry.target);
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          els.forEach(function (el) {
            io.observe(el);
          });
        };

        Promise.race([fontsReady, new Promise(function (r) { setTimeout(r, 1200); })]).then(start);

        /* 保底：4 秒后凡是还在视口里却没显示的，直接显示。
           防的是浏览器把 IntersectionObserver 节流掉导致内容永远不出现。 */
        setTimeout(function () {
          els.forEach(function (el) {
            if (el.classList.contains('is-in')) return;
            var r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) reveal(el);
          });
        }, 4000);
      })();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: -60px;
    left: 24px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 10px;
    background: var(--c-ink);
    color: var(--c-canvas);
    font-size: 14px;
    transition: top 160ms var(--ease-apple);
  }

  .skip:focus-visible {
    top: 12px;
    outline-color: var(--c-pink);
  }
</style>
