---
import '../styles/global.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-serif-sc/700.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'WHY —— 项目、竞赛、思考，以及正在做的事。',
  ogType = 'website',
} = Astro.props;

const pageTitle = title ? `${title} · WHY` : 'WHY · 无限进步';
const site = Astro.site ?? new URL('https://qwhyq.pages.dev');
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#f4b1c5" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="WHY" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={`${site.origin}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="WHY · 无限进步" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site.origin}/og.png`} />
    <link rel="alternate" type="application/rss+xml" title="WHY" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到主要内容</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      (function () {
        /* ---------- 导航栏：滚动后变毛玻璃 ---------- */
        var nav = document.querySelector('.nav-wrap');
        if (nav) {
          var syncNav = function () {
            nav.classList.toggle('is-scrolled', (window.scrollY || 0) > 8);
          };
          window.addEventListener('scroll', syncNav, { passive: true });
          syncNav();
        }

        /* ---------- 文字浮现 ---------- */
        var els = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
        if (!els.length) return;

        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (el) {
            el.classList.add('is-in');
          });
          return;
        }

        /*
         * 字体是拦路的：明朝体按 unicode-range 切成上百个分片，
         * 某个页面用到的字片没下载完，浏览器就会先画回退字体再 swap。
         *
         * 注意 document.fonts.ready 只是"等已经进入下载队列的字体"，
         * 正文（含章节标题）里的字片可能还没被请求，它就返回了 ——
         * 于是正文先显示回退字体、随后突然变成明朝。
         * 所以这里按每个元素实际用到的文字，用 document.fonts.load 主动点名加载。
         */
        var reveal = function (el) {
          el.classList.add('is-in');
        };

        var fontSpec = function (el) {
          var cs = window.getComputedStyle(el);
          var family = (cs.fontFamily || 'sans-serif').split(',')[0].replace(/["']/g, '').trim();
          return cs.fontStyle + ' ' + cs.fontWeight + ' ' + cs.fontSize + ' ' + family;
        };

        var loaders = [];
        if (document.fonts && document.fonts.load) {
          els.slice(0, 30).forEach(function (el) {
            var text = (el.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 240);
            if (!text) return;
            loaders.push(document.fonts.load(fontSpec(el), text).catch(function () {}));
          });
        }

        var start = function () {
          /*
           * 视口内的元素直接显示，不依赖 IntersectionObserver ——
           * IO 在某些环境（省电模式、无头浏览器、后台标签页）会被节流，
           * 一旦它不回调，首屏就会一直是空白。先手算一遍位置最稳。
           */
          var rest = [];
          els.forEach(function (el) {
            var r = el.getBoundingClientRect();
            var inView = r.top < window.innerHeight * 1.02 && r.bottom > 0;
            if (inView) reveal(el);
            else rest.push(el);
          });

          if (!rest.length) return;

          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  reveal(entry.target);
                  io.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          rest.forEach(function (el) {
            io.observe(el);
          });
        };

        /*
         * 等字体加载完 + 40ms 再开始：这 40ms 保证 opacity:0 的初始态
         * 至少被真正绘制过一帧，否则浏览器会把"隐藏"和"显示"合成一帧，
         * 过渡根本不跑（表现就是文字直接蹦出来，没有浮现）。
         */
        Promise.race([
          Promise.all(loaders),
          new Promise(function (r) {
            setTimeout(r, 900);
          }),
        ]).then(function () {
          setTimeout(start, 40);
        });

        /* 保底：4 秒后凡是还在视口里却没显示的，直接显示。
           防的是浏览器把 IntersectionObserver 节流掉导致内容永远不出现。 */
        setTimeout(function () {
          els.forEach(function (el) {
            if (el.classList.contains('is-in')) return;
            var r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) reveal(el);
          });
        }, 4000);
      })();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: -60px;
    left: 24px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 10px;
    background: var(--c-ink);
    color: var(--c-canvas);
    font-size: 14px;
    transition: top 160ms var(--ease-apple);
  }

  .skip:focus-visible {
    top: 12px;
    outline-color: var(--c-pink);
  }
</style>
