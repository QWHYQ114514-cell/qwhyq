---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { STATUS_LABEL, fmtMonth } from '../../lib/format';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, status, start, role, stack, repo, demo, summary } = project.data;
---

<Base title={title} description={summary} ogType="article">
  <article class="detail">
    <div class="container">
      <a class="back" href="/projects/">← 全部项目</a>

      <p class="eyebrow detail-eyebrow">
        <span>{STATUS_LABEL[status]}</span>
        <span class="sep">/</span>
        <span>{fmtMonth(start)} 开始</span>
      </p>

      <h1 class="h1">{title}</h1>
      <p class="lead detail-lead">{summary}</p>

      <dl class="meta">
        <div>
          <dt>角色</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt>技术栈</dt>
          <dd>{stack.join(' · ')}</dd>
        </div>
        <div>
          <dt>开始</dt>
          <dd>{fmtMonth(start)}</dd>
        </div>
        {
          (repo || demo) && (
            <div>
              <dt>链接</dt>
              <dd>
                {repo && (
                  <a href={repo} rel="noopener">
                    仓库
                  </a>
                )}
                {repo && demo && <span class="sep"> · </span>}
                {demo && (
                  <a href={demo} rel="noopener">
                    演示
                  </a>
                )}
              </dd>
            </div>
          )
        }
      </dl>

      <hr class="rule" />

      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .detail {
    padding-block: clamp(40px, 6vw, 72px) var(--space-section);
  }

  .back {
    display: inline-block;
    margin-bottom: 40px;
    font-size: var(--fs-caption);
    color: var(--c-ink-3);
    transition: color var(--dur-micro) var(--ease-apple);
  }

  .back:hover {
    color: var(--c-ink);
  }

  .detail-eyebrow {
    display: flex;
    gap: 10px;
  }

  .sep {
    color: var(--c-line);
  }

  h1 {
    margin-top: 20px;
    max-width: 18em;
  }

  .detail-lead {
    margin-top: 24px;
    max-width: 30em;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 24px;
    margin: 48px 0 40px;
  }

  .meta dt {
    margin-bottom: 6px;
    font-size: var(--fs-caption);
    letter-spacing: 0.08em;
    color: var(--c-ink-3);
  }

  .meta dd {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .meta a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--c-line);
  }

  .meta a:hover {
    text-decoration-color: var(--c-ink);
  }

  .prose {
    margin-top: 40px;
  }

  @media (max-width: 720px) {
    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
      margin: 36px 0 32px;
    }
  }
</style>
