---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const order = { building: 0, live: 1, seed: 2, archived: 3 } as const;

const projects = (await getCollection('projects')).sort((a, b) => {
  const byStatus = order[a.data.status] - order[b.data.status];
  return byStatus !== 0 ? byStatus : b.data.start.localeCompare(a.data.start);
});
---

<Base title="项目" description="项目列表：正在做的、做完了的，和还只是想法的。">
  <PageHeader title="项目" />

  <section class="section">
    <div class="container">
      <div class="grid-work">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .section {
    padding-top: 8px;
  }

  .grid-work {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    align-items: stretch;
  }
</style>
