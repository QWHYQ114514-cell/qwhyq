---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { fmtDate } from '../lib/format';

const now = (await getCollection('now'))[0];

const items = now
  ? [
      { label: '在学', value: now.data.learning },
      { label: '在做', value: now.data.building },
      { label: '在读', value: now.data.reading },
      { label: '在找', value: now.data.looking },
    ]
  : [];
---

<Base
  title="Now"
  description="这个站最常更新的一页：目前在学什么、在做什么、在读什么、在找什么。"
>
  <PageHeader title="现在" />

  <section class="section">
    <div class="container">
      <dl class="items">
        {
          items.map((item) => (
            <div class="item" data-reveal>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        now && (
          <p class="updated" data-reveal>
            更新于 {fmtDate(now.data.updated)} · 每月至少改一次
          </p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .section {
    padding-top: 8px;
  }

  .items {
    margin: 0;
    border-top: 1px solid var(--c-line);
  }

  .item {
    display: grid;
    grid-template-columns: 120px 1fr;
    align-items: baseline;
    gap: 32px;
    padding-block: 28px;
    border-bottom: 1px solid var(--c-line);
  }

  dt {
    font-size: var(--fs-caption);
    letter-spacing: 0.08em;
    color: var(--c-ink-3);
  }

  dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.6;
  }

  .updated {
    margin-top: 32px;
    font-size: var(--fs-caption);
    color: var(--c-ink-3);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .item {
      grid-template-columns: 1fr;
      gap: 8px;
      padding-block: 20px;
    }
    dd {
      font-size: 20px;
    }
  }
</style>
