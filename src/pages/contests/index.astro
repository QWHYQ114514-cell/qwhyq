---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { fmtDate } from '../../lib/format';

const contests = (await getCollection('contests')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title="竞赛" description="参加过的比赛：赛题、准备过程、现场情况和复盘。">
  <PageHeader title="竞赛" />

  <section class="section">
    <div class="container">
      {
        contests.length === 0 ? (
          <p class="empty">2026–2027 赛季 · 备赛中</p>
        ) : (
          <ul class="list">
            {contests.map((contest) => (
              <li>
                <a href={`/contests/${contest.id}/`}>
                  <time datetime={contest.data.date.toISOString()}>
                    {fmtDate(contest.data.date)}
                  </time>
                  <span class="title">{contest.data.title}</span>
                  <span class="track">{contest.data.track}</span>
                  <span class="pill pill--outline">{contest.data.result}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>

<style>
  .section {
    padding-top: 8px;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-line);
  }

  .list li {
    border-bottom: 1px solid var(--c-line);
    border-radius: 14px;
    transition:
      background-color var(--dur-micro) var(--ease-apple),
      box-shadow var(--dur-micro) var(--ease-apple),
      transform var(--dur-micro) var(--ease-apple),
      border-color var(--dur-micro) var(--ease-apple);
  }

  .list li:hover {
    background: var(--c-raised);
    border-bottom-color: transparent;
    box-shadow: 0 10px 34px rgba(0, 0, 0, 0.08);
    transform: translateY(-1px);
  }

  .list a {
    display: grid;
    grid-template-columns: 104px 1fr 96px 96px;
    align-items: center;
    gap: 20px;
    padding: 26px 16px;
  }

  time {
    font-size: var(--fs-caption);
    color: var(--c-ink-3);
    font-variant-numeric: tabular-nums;
  }

  .title {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.5;
  }

  .track {
    font-size: var(--fs-caption);
    color: var(--c-ink-3);
  }

  .empty {
    font-family: var(--font-serif);
    font-size: 21px;
    color: var(--c-ink-2);
  }

  @media (max-width: 720px) {
    .list a {
      grid-template-columns: 1fr auto;
      gap: 8px 16px;
      padding-block: 20px;
    }
    .title {
      grid-column: 1 / -1;
      order: -1;
      font-size: 19px;
    }
    .track {
      display: none;
    }
  }
</style>
