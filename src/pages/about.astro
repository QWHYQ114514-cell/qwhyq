---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

const timeline = [
  { when: '2026.09', what: '入学，人工智能专业。' },
  { when: '2026.10', what: '放弃「先学框架」的路线，回头补数学。开始搭这个网站。' },
];

const skills = [
  {
    label: '会用',
    items: ['Python', 'NumPy 基础', 'Git 基础', 'Markdown'],
  },
  {
    label: '在学',
    items: ['线性代数', '微积分', '概率论与数理统计', 'C++'],
  },
  {
    label: '想学',
    items: ['PyTorch', '机器学习实践', '计算机系统'],
  },
];
---

<Base title="关于" description="一个学人工智能的大一学生：在读什么、会什么、怎么联系。">
  <PageHeader title="关于" />

  <section class="block">
    <div class="container">
      <h2 class="h2 block-title">经历</h2>
      <ul class="timeline">
        {
          timeline.map((item) => (
            <li data-reveal>
              <span class="when">{item.when}</span>
              <span class="what">{item.what}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <h2 class="h2 block-title">技能</h2>
      <div class="skills">
        {
          skills.map((group) => (
            <div class="skill" data-reveal>
              <h3>{group.label}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block block--last">
    <div class="container">
      <h2 class="h2 block-title">联系</h2>
      <ul class="contact" data-reveal>
        <li>
          <span class="label">邮箱</span>
          <a href="mailto:QWHYQ114514@outlook.com">QWHYQ114514@outlook.com</a>
        </li>
        <li>
          <span class="label">GitHub</span>
          <a href="https://github.com/QWHYQ114514-cell" rel="me">@QWHYQ114514-cell</a>
        </li>
        <li>
          <span class="label">本站</span>
          <span>qwhyq.com</span>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .block {
    padding-block: clamp(48px, 6vw, 80px);
    border-top: 1px solid var(--c-line);
  }

  .block--last {
    padding-bottom: var(--space-section);
  }

  .block-title {
    margin-bottom: 40px;
    font-size: clamp(24px, 3vw, 32px);
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 32px;
    padding-block: 20px;
    border-bottom: 1px solid var(--c-line);
  }

  .timeline li:first-child {
    border-top: 1px solid var(--c-line);
  }

  .when {
    font-size: var(--fs-caption);
    color: var(--c-ink-3);
    font-variant-numeric: tabular-nums;
  }

  .what {
    font-size: var(--fs-body);
    line-height: 1.7;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .skill h3 {
    margin-bottom: 16px;
    font-family: var(--font-sans);
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--c-ink-3);
  }

  .skill ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill li {
    padding-block: 8px;
    border-bottom: 1px solid var(--c-line);
    font-size: var(--fs-sm);
  }

  .contact {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact li {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 32px;
    padding-block: 18px;
    border-bottom: 1px solid var(--c-line);
  }

  .contact li:first-child {
    border-top: 1px solid var(--c-line);
  }

  .label {
    font-size: var(--fs-caption);
    color: var(--c-ink-3);
    letter-spacing: 0.08em;
  }

  .contact a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--c-line);
    transition: text-decoration-color var(--dur-micro) var(--ease-apple);
  }

  .contact a:hover {
    text-decoration-color: var(--c-ink);
  }

  @media (max-width: 720px) {
    .skills {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .timeline li,
    .contact li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
