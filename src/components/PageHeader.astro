---
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<header class="page-head">
  <div class="container">
    <h1 class="h1" data-reveal>{title}</h1>
    {lead && <p class="lead lead-text" data-reveal>{lead}</p>}
  </div>
</header>

<style>
  .page-head {
    padding-top: clamp(56px, 9vw, 112px);
    padding-bottom: clamp(32px, 4vw, 48px);
  }

  .lead-text {
    margin-top: 22px;
    max-width: 32em;
  }
</style>
